from __future__ import annotations

from dataclasses import dataclass, field
from typing import Any, Literal


AgentEventType = Literal[
    "run_started",
    "step_started",
    "step_finished",
    "text_delta",
    "tool_started",
    "tool_args_delta",
    "tool_finished",
    "tool_result",
    "plan_created",
    "diff_ready",
    "approval_required",
    "test_finished",
    "run_finished",
    "run_error",
]


@dataclass(slots=True)
class AgentEvent:
    type: AgentEventType
    run_id: str
