Map Internal Events to AG-UI
The adapter becomes the only place that knows both your internal events and AG-UI’s public event format.

python
# app/agui/event_mapper.py
from __future__ import annotations

from typing import Any

from app.agui.schemas import AgentEvent


class AGUIEventMapper:
    def to_agui(self, event: AgentEvent) -> dict[str, Any]:
        match event.type:
            case "run_started":
                return {
                    "type": "RUN_STARTED",
                    "threadId": event.thread_id,
                    "runId": event.run_id,
                }

            case "step_started":
                return {
                    "type": "STEP_STARTED",
                    "stepName": event.data["name"],
                }

            case "step_finished":
                return {
                    "type": "STEP_FINISHED",
                    "stepName": event.data["name"],
                }

            case "text_delta":
                return {
                    "type": "TEXT_MESSAGE_CONTENT",
                    "messageId": event.data["message_id"],
                    "delta": event.data["delta"],
                }

            case "tool_started":
                return {
                    "type": "TOOL_CALL_START",
                    "toolCallId": event.data["tool_call_id"],
                    "toolCallName": event.data["tool_name"],
                }

            case "tool_args_delta":
                return {
                    "type": "TOOL_CALL_ARGS",
                    "toolCallId": event.data["tool_call_id"],
                    "delta": event.data["delta"],
                }

            case "tool_finished":
                return {
                    "type": "TOOL_CALL_END",
                    "toolCallId": event.data["tool_call_id"],
                }

            case "tool_result":
                return {
                    "type": "TOOL_CALL_RESULT",
                    "toolCallId": event.data["tool_call_id"],
                    "content": event.data["content"],
                }

            case "plan_created":
                return {
                    "type": "CUSTOM",
                    "name": "hypercode.plan.created",
                    "value": event.data,
                }

            case "diff_ready":
                return {
                    "type": "CUSTOM",
                    "name": "hypercode.diff.ready",
                    "value": event.data,
                }

            case "approval_required":
                return {
                    "type": "CUSTOM",
                    "name": "hypercode.approval.required",
                    "value": event.data,
                }

            case "test_finished":
                return {
                    "type": "CUSTOM",
                    "name": "hypercode.test.finished",
                    "value": event.data,
                }

            case "run_finished":
                return {
                    "type": "RUN_FINISHED",
                    "threadId": event.thread_id,
                    "runId": event.run_id,
                }

            case "run_error":
                return {
                    "type": "RUN_ERROR",
                    "message": event.data["message"],
                    "code": event.data.get("code", "AGENT_RUN_FAILED"),
                }

            case _:
                raise ValueError(f"Unsupported agent event: {event.type}")
AG-UI formally defines lifecycle events including RUN_STARTED, RUN_FINISHED, and RUN_ERROR, as well as structured text and tool-call events.

SSE Serializer
Keep streaming and serialisation separate from orchestration logic.

python
# app/agui/serializer.py
from __future__ import annotations

import json
from typing import Any


def encode_sse(event: dict[str, Any]) -> str:
    payload = json.dumps(
        event,
        ensure_ascii=False,
        separators=(",", ":"),
    )
    return f"data: {payload}\n\n"


def encode_heartbeat() -> str:
    return ": keepalive\n\n"
The : keepalive line is a valid SSE comment. It helps prevent reverse proxies from closing long-running streams.

Adapter Implementation
This is the core component.

python
# app/agui/adapter.py
from __future__ import annotations

import asyncio
import logging
from collections.abc import AsyncGenerator
from typing import Any

from app.agui.event_mapper import AGUIEventMapper
from app.agui.redaction import redact_event
from app.agui.schemas import AgentEvent
from app.agui.serializer import encode_heartbeat, encode_sse

logger = logging.getLogger(__name__)


class AGUIAdapter:
    def __init__(
        self,
        orchestrator: Any,
        heartbeat_seconds: float = 15.0,
    ) -> None:
        self.orchestrator = orchestrator
        self.mapper = AGUIEventMapper()
        self.heartbeat_seconds = heartbeat_seconds

    async def stream(
        self,
        *,
        request: Any,
        run_id: str,
        thread_id: str,
        user_id: str,
        workspace_id: str,
    ) -> AsyncGenerator[str, None]:
        agent_events = self.orchestrator.run(
            request=request,
            run_id=run_id,
            thread_id=thread_id,
            user_id=user_id,
            workspace_id=workspace_id,
        )

        iterator = agent_events.__aiter__()

        while True:
            try:
                event: AgentEvent = await asyncio.wait_for(
                    iterator.__anext__(),
                    timeout=self.heartbeat_seconds,
                )
            except TimeoutError:
                yield encode_heartbeat()
                continue
            except StopAsyncIteration:
                break
            except asyncio.CancelledError:
                logger.info("AG-UI client disconnected", extra={"run_id": run_id})
                raise
            except Exception:
                logger.exception("AG-UI stream failed", extra={"run_id": run_id})

                error_event = AgentEvent(
                    type="run_error",
                    run_id=run_id,
                    thread_id=thread_id,
                    agent_name="agui-adapter",
                    data={
                        "message": "The agent stream stopped unexpectedly.",
                        "code": "STREAM_FAILURE",
                    },
                )
                yield encode_sse(self.mapper.to_agui(error_event))
                break

            safe_event = redact_event(event)
            agui_event = self.mapper.to_agui(safe_event)

            await self._persist_event(
                run_id=run_id,
                agent_name=safe_event.agent_name,
                event=agui_event,
            )

            yield encode_sse(agui_event)

    async def _persist_event(
        self,
        *,
        run_id: str,
        agent_name: str,
        event: dict[str, Any],
    ) -> None:
        # Replace with PostgreSQL event persistence.
        # Persist first, then stream, so reconnect/replay is possible.
        logger.debug(
            "AG-UI event",
            extra={
                "run_id": run_id,
                "agent_name": agent_name,
                "event_type": event["type"],
            },
        )
Important: persist important events before sending them. If the browser refreshes, the user can reconnect and request missed events.

Minimal Redaction Layer
Never trust an agent, tool, or log to remove secrets for you.

python
# app/agui/redaction.py
from __future__ import annotations

import re
from copy import deepcopy

from app.agui.schemas import AgentEvent

SENSITIVE_KEYS = {
    "api_key",
    "authorization",
    "cookie",
    "password",
    "secret",
    "token",
    "private_key",
    "webhook_secret",
}

SECRET_PATTERNS = [
    re.compile(r"sk-[A-Za-z0-9_-]{16,}"),
    re.compile(r"gh[pousr]_[A-Za-z0-9_]{20,}"),
    re.compile(r"AKIA[A-Z0-9]{16}"),
]


def redact_event(event: AgentEvent) -> AgentEvent:
    copied = deepcopy(event)
    copied.data = _redact_value(copied.data)
    return copied


def _redact_value(value: object, key: str = "") -> object:
    if key.lower() in SENSITIVE_KEYS:
        return "[REDACTED]"

    if isinstance(value, dict):
        return {
            item_key: _redact_value(item_value, item_key)
            for item_key, item_value in value.items()
        }

    if isinstance(value, list):
        return [_redact_value(item) for item in value]

    if isinstance(value, str):
        redacted = value
        for pattern in SECRET_PATTERNS:
            redacted = pattern.sub("[REDACTED]", redacted)
        return redacted

    return value
FastAPI Router
Use an endpoint that authenticates first, creates a controlled run context, then returns the stream.

python
# app/api/agui.py
from __future__ import annotations

import uuid

from fastapi import APIRouter, Depends, Request
from fastapi.responses import StreamingResponse
from pydantic import BaseModel, Field

from app.agui.adapter import AGUIAdapter
from app.services.agent_orchestrator import AgentOrchestrator
from app.auth.dependencies import get_current_user

router = APIRouter(prefix="/api/agui", tags=["ag-ui"])


class StartAgentRunRequest(BaseModel):
    thread_id: str = Field(alias="threadId")
    input: str
    workspace_id: str = Field(alias="workspaceId")
    repository: str | None = None

    model_config = {"populate_by_name": True}


def get_adapter() -> AGUIAdapter:
    orchestrator = AgentOrchestrator()
    return AGUIAdapter(orchestrator=orchestrator)


@router.post("/runs")
async def start_agent_run(
    body: StartAgentRunRequest,
    request: Request,
    user=Depends(get_current_user),
    adapter: AGUIAdapter = Depends(get_adapter),
) -> StreamingResponse:
    run_id = str(uuid.uuid4())

    return StreamingResponse(
        adapter.stream(
            request=body,
            run_id=run_id,
            thread_id=body.thread_id,
            user_id=str(user.id),
            workspace_id=body.workspace_id,
        ),
        media_type="text/event-stream",
        headers={
            "Cache-Control": "no-cache, no-transform",
            "Connection": "keep-alive",
            "X-Accel-Buffering": "no",
        },
    )
Then wire the router in the FastAPI application:

python
# app/main.py
from fastapi import FastAPI

from app.api.agui import router as agui_router

app = FastAPI()
app.include_router(agui_router)
FastAPI and other Starlette-based apps can return protocol streaming responses directly, and AG-UI integrations commonly stream the translated agent events as SSE.

