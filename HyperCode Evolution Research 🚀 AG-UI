FastAPI Starter
This fits HyperCode-V2.4’s FastAPI direction. Keep imports as from app.X import Y, not from backend.app.X.

python
# app/api/agui.py
from __future__ import annotations

import asyncio
import json
import uuid
from collections.abc import AsyncGenerator

from fastapi import APIRouter
from fastapi.responses import StreamingResponse
from pydantic import BaseModel, Field

router = APIRouter(prefix="/api/agui", tags=["ag-ui"])


class RunRequest(BaseModel):
    thread_id: str = Field(alias="threadId")
    run_id: str | None = Field(default=None, alias="runId")
    input: str
    repository: str | None = None

    model_config = {"populate_by_name": True}


def sse(event: dict) -> str:
    return f"data: {json.dumps(event)}\n\n"


async def hypercode_event_stream(
    request: RunRequest,
) -> AsyncGenerator[str, None]:
    run_id = request.run_id or str(uuid.uuid4())

    yield sse({
        "type": "RUN_STARTED",
        "threadId": request.thread_id,
        "runId": run_id,
    })

    yield sse({
        "type": "STEP_STARTED",
        "stepName": "planning",
    })

    yield sse({
        "type": "CUSTOM",
        "name": "hypercode.plan.created",
        "value": {
            "runId": run_id,
            "summary": "Mapping the repository before proposing changes.",
            "steps": [
                "Inspect architecture",
                "Create implementation plan",
                "Request approval before write actions",
            ],
            "risk": "low",
        },
    })

    yield sse({
        "type": "STEP_FINISHED",
        "stepName": "planning",
    })

    yield sse({
        "type": "TEXT_MESSAGE_START",
        "messageId": f"{run_id}:status",
        "role": "assistant",
    })

    for token in [
        "I’m mapping the project first. ",
        "No files will be changed without approval.",
    ]:
        yield sse({
            "type": "TEXT_MESSAGE_CONTENT",
            "messageId": f"{run_id}:status",
            "delta": token,
        })
        await asyncio.sleep(0.03)

    yield sse({
        "type": "TEXT_MESSAGE_END",
        "messageId": f"{run_id}:status",
    })

    yield sse({
        "type": "RUN_FINISHED",
        "threadId": request.thread_id,
        "runId": run_id,
    })


@router.post("/runs")
async def run_agent(request: RunRequest) -> StreamingResponse:
    return StreamingResponse(
        hypercode_event_stream(request),
        media_type="text/event-stream",
        headers={
            "Cache-Control": "no-cache",
            "Connection": "keep-alive",
            "X-Accel-Buffering": "no",
        },
    )
AG-UI’s Python ecosystem supports implementing endpoints that stream protocol events directly from FastAPI or Starlette applications.

