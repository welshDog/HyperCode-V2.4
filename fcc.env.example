# FCC Environment Variables — copy relevant lines into your .env (NEVER commit real keys)

# Required
FCC_AUTH_TOKEN=freecc

# NVIDIA NIM — free 40 req/min — https://build.nvidia.com/settings/api-keys
NVIDIA_NIM_API_KEY=nvapi-xxxxxxxxxxxxxxxxxxxx

# OpenRouter — free tier — https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-xxxxxxxxxxxxxxxxxxxx

# Gemini — free tier — https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AIzaxxxxxxxxxxxxxxxxxxxxxxxxxx

# Discord bot (optional) — https://discord.com/developers/applications
FCC_DISCORD_BOT_TOKEN=your-discord-bot-token
FCC_DISCORD_ALLOWED_CHANNELS=123456789012345678,987654321098765432
FCC_DISCORD_ALLOWED_DIRECTORY=/workspace
