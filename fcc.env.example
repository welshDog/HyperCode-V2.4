# FCC Environment Variables — copy into your .env (NEVER commit real keys)
# Refs: https://github.com/Alishahryar1/free-claude-code

# Proxy auth token (Claude Code sends this as ANTHROPIC_AUTH_TOKEN)
# Generate your own: openssl rand -hex 16
# Manual testing note: FCC only accepts "Authorization: Bearer <token>" — NOT
# the "x-api-key" header (that's for ANTHROPIC_API_KEY, a different Claude Code
# env var). `curl -H "x-api-key: ..."` will always 401 against this proxy.
ANTHROPIC_AUTH_TOKEN=<your-token-here>

# Default model + per-Claude-tier overrides (all real FCC env vars — see
# https://github.com/Alishahryar1/free-claude-code README "Model Config").
# Set to ollama/* to keep every tier on free/unlimited local Ollama; leave
# NVIDIA_NIM_API_KEY below populated and configure an ordered Fallback Models
# list in the Admin UI (http://localhost:8083/admin -> Model Config) so FCC
# automatically fails over to NIM if Ollama is down. There's no env var or
# config file for the fallback list itself — Admin UI only.
MODEL=ollama/llama3.1
MODEL_FABLE=ollama/llama3.1
MODEL_OPUS=ollama/llama3.1
MODEL_SONNET=ollama/llama3.1
MODEL_HAIKU=ollama/llama3.1

# NVIDIA NIM — FREE 40 req/min — https://build.nvidia.com/settings/api-keys
NVIDIA_NIM_API_KEY=nvapi-xxxxxxxxxxxxxxxxxxxx

# OpenRouter — free tier — https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-xxxxxxxxxxxxxxxxxxxx

# Gemini — free tier — https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AIzaxxxxxxxxxxxxxxxxxxxxxxxxxx

# Ollama (local — already set in compose to hypercode-ollama)
OLLAMA_BASE_URL=http://hypercode-ollama:11434

# Discord bot (optional) — set MESSAGING_PLATFORM=discord to enable
# Create bot: https://discord.com/developers/applications
MESSAGING_PLATFORM=none
DISCORD_BOT_TOKEN=your-discord-bot-token
ALLOWED_DISCORD_CHANNELS=123456789012345678,987654321098765432
ALLOWED_DIR=/workspace

# VS Code setup (add to VS Code settings.json):
# "claudeCode.disableLoginPrompt": true,
# "claudeCode.environmentVariables": [
#   { "name": "ANTHROPIC_BASE_URL", "value": "http://localhost:8083" },
#   { "name": "ANTHROPIC_AUTH_TOKEN", "value": "<your-token-here>" },
#   { "name": "CLAUDE_CODE_ENABLE_GATEWAY_MODEL_DISCOVERY", "value": "1" }
# ]
