# 🤖 broski-bot — ENV vars
# Copy to .env (NEVER commit .env to git!)
# Location: agents/broski-bot/.env

# Discord
DISCORD_TOKEN=your_discord_bot_token_here
GUILD_ID=123456789012345678
MISSIONS_CHANNEL_ID=123456789012345678

# Supabase (for BROski$ economy + member data)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_anon_or_service_key

# FastAPI (internal Docker network — do NOT change unless port changes)
FASTAPI_BASE=http://hypercode-core:8000

# Persistence paths (matches HC_DATA_ROOT in compose)
BOT_DB_PATH=/opt/hypercode/data/broski-bot/db
BOT_LOGS_PATH=/opt/hypercode/data/broski-bot/logs
BOT_BACKUPS_PATH=/opt/hypercode/data/broski-bot/backups
