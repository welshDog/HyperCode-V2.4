# 🤖 broski-bot — ENV vars
# Copy to .env — NEVER commit .env to git!
# Location: agents/broski-bot/.env

# Discord
# DISCORD_TOKEN can be provided via Docker secrets (DISCORD_TOKEN_FILE).
DISCORD_TOKEN=
DISCORD_COMMAND_PREFIX=/
DISCORD_GUILD_ID=

# Core integration
HYPERCODE_API_URL=http://hypercode-core:8000
WORKSPACE_PATH=/workspace

# NemoClaw Layer 3 Voice — autonomous code-health announcements
# Channel the bot posts pulses to. Right-click channel → Copy Channel ID
# (Discord Developer Mode on). Leave blank to disable the auto-loop.
CODE_HEALTH_CHANNEL_ID=
# How often the background pulse runs (hours). Default 24.
NEMOCLAW_PULSE_HOURS=24

# Server Guardian Phase 1 — Reactive layer
# Role auto-assigned to every new member on join. Must exist in the guild
# (run /hyperfocus_setup once to create it). Default "BROski".
AUTO_ROLE_NAME=BROski
# Channel name (not ID) the welcome embed posts to. Default "welcome".
WELCOME_CHANNEL_NAME=welcome

# Server Guardian Phase 2 — Weekly digest DM
# Discord user ID that receives the weekly digest (Lyndz). Falls back to
# DISCORD_USER_ID if unset. Leave blank to disable the auto-loop.
DIGEST_DM_USER_ID=
# Day of week the digest auto-sends. 0=Mon … 6=Sun. Default 0 (Monday).
DIGEST_WEEKDAY=0

# Server Guardian Phase 3a — reversible auto-mod (spam + optional blocklist)
# Channel ID for the mod-action audit log. Blank = no log post.
MOD_LOG_CHANNEL_ID=
# Comma-separated blocked words/phrases. EMPTY by default — opt-in only.
# Structural spam detection works without this. Values call is yours.
MOD_BLOCKLIST=
# Spam thresholds: N messages within W seconds = rate flood.
MOD_SPAM_MSGS=6
MOD_SPAM_WINDOW=8
# Single message with this many mentions = mention flood.
MOD_MENTION_LIMIT=6
# Same message repeated this many times = duplicate flood.
MOD_DUPLICATE_LIMIT=4

# Server Guardian Phase 3b — raid auto-lockdown (reversible)
# N joins within W seconds = raid → channels auto-locked.
RAID_JOIN_THRESHOLD=5
RAID_WINDOW_SECONDS=10
# Auto-unlock window is a CORE setting (RAID_LOCKDOWN_MINUTES, default 10) —
# override in the root .env if needed, not here.

# Data services (defaults are Docker service names in the V2.4 stack)
REDIS_URL=redis://redis:6379/0
DB_HOST=postgres
DB_PORT=5432
DB_NAME=broski
DB_USER=postgres

# Database password for the bot's Postgres DB.
# Prefer Docker secrets (secrets/postgres_password.txt) via docker-compose.secrets.yml.
POSTGRES_PASSWORD=
