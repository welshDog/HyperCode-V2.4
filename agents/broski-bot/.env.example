# 🤖 broski-bot — ENV vars
# Copy to .env — NEVER commit .env to git!
# Location: agents/broski-bot/.env
# All 8 keys are now present (audit fix May 15 2026)

# ── Discord [REQUIRED] ────────────────────────────────────────────────────────────────────────────────────
DISCORD_TOKEN=your_bot_token_here
GUILD_ID=123456789012345678          # right-click server → Copy Server ID
MISSIONS_CHANNEL_ID=123456789012345678  # right-click #missions channel → Copy ID

# ── Supabase [REQUIRED] ───────────────────────────────────────────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_service_role_key   # use service role key (not anon) for bot writes

# ── FastAPI [REQUIRED] ───────────────────────────────────────────────────────────────────────────────────
FASTAPI_BASE=http://hypercode-core:8000   # internal Docker service name — do NOT change

# ── Persistence Paths [REQUIRED — must match HC_DATA_ROOT in root .env] ───────────────────────────────────────────────────────────────────────────────────
BOT_DB_PATH=/opt/hypercode/data/broski-bot/db
BOT_LOGS_PATH=/opt/hypercode/data/broski-bot/logs
BOT_BACKUPS_PATH=/opt/hypercode/data/broski-bot/backups
