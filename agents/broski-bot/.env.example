# 🤖 broski-bot — ENV vars
# Copy to .env — NEVER commit .env to git!
# Location: agents/broski-bot/.env

# Discord
# DISCORD_TOKEN can be provided via Docker secrets (DISCORD_TOKEN_FILE).
DISCORD_TOKEN=
DISCORD_COMMAND_PREFIX=/
DISCORD_GUILD_ID=

# Core integration
HYPERCODE_API_URL=http://hypercode-core:8000
WORKSPACE_PATH=/workspace

# NemoClaw Layer 3 Voice — autonomous code-health announcements
# Channel the bot posts pulses to. Right-click channel → Copy Channel ID
# (Discord Developer Mode on). Leave blank to disable the auto-loop.
CODE_HEALTH_CHANNEL_ID=
# How often the background pulse runs (hours). Default 24.
NEMOCLAW_PULSE_HOURS=24

# Data services (defaults are Docker service names in the V2.4 stack)
REDIS_URL=redis://redis:6379/0
DB_HOST=postgres
DB_PORT=5432
DB_NAME=broski
DB_USER=postgres

# Database password for the bot's Postgres DB.
# Prefer Docker secrets (secrets/postgres_password.txt) via docker-compose.secrets.yml.
POSTGRES_PASSWORD=
