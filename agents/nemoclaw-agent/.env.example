# nemoclaw-agent — env vars (defaults work inside the V2.4 compose stack)
# DO NOT commit a real .env

# Auth — must match the master API key used by hypercode-core
# Provided via Docker secret in production: HYPERCODE_API_KEY_FILE
HYPERCODE_API_KEY=

# Postgres (defaults match V2.4 stack)
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=hypercode
POSTGRES_USER=postgres
POSTGRES_PASSWORD=

# Where the repo is mounted (read-only)
WORKSPACE_PATH=/workspace

# Comma-separated subdirs to scan (relative to WORKSPACE_PATH)
NEMOCLAW_SCAN_TARGETS=backend,agents
