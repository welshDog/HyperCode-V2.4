# Shared base layer for all Python agents (FastAPI + docker CLI + dependencies)
#
# This image is NOT built by compose — children (agents/coder/Dockerfile) do
# FROM agent-base:latest and fail with "pull access denied" if it's missing
# (e.g. after a docker prune). Rebuild it with:
#   docker build -t agent-base:latest -f agents/Dockerfile.base agents/
FROM python:3.12-slim AS agent-base

WORKDIR /app

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIPX_HOME=/opt/pipx \
    PIPX_BIN_DIR=/usr/local/bin

# OS package hardening — upgrade all + install docker-ce-cli (official Docker repo)
RUN apt-get update --allow-releaseinfo-change && \
    apt-get upgrade -y && \
    apt-get install -y --no-install-recommends \
        ca-certificates \
        curl \
        gnupg \
        git \
        libexpat1 \
        openssl && \
    install -m 0755 -d /etc/apt/keyrings && \
    curl -fsSL https://download.docker.com/linux/debian/gpg | gpg --dearmor -o /etc/apt/keyrings/docker.gpg && \
    chmod a+r /etc/apt/keyrings/docker.gpg && \
    echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/docker.gpg] https://download.docker.com/linux/debian $(. /etc/os-release && echo "$VERSION_CODENAME") stable" \
        | tee /etc/apt/sources.list.d/docker.list > /dev/null && \
    apt-get update && \
    apt-get install -y --no-install-recommends docker-ce-cli && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/* /tmp/* /var/tmp/*

# Pip tool hardening — pin safe versions
RUN pip install --upgrade --no-cache-dir \
    "pip==26.0.1" \
    "setuptools>=80.0.0" \
    "wheel==0.46.2" \
    "jaraco.context>=6.0.0" \
    "jaraco.functools>=4.1.0" \
    "jaraco.text>=4.0.0"

# Install common agent dependencies (FastAPI, Redis, etc.)
RUN pip install --no-cache-dir \
    fastapi==0.109.2 \
    uvicorn==0.27.0 \
    redis==5.0.1 \
    aiohttp==3.9.3 \
    pydantic==2.6.4 \
    python-dotenv==1.0.0 \
    requests==2.31.0 \
    httpx==0.25.2

# Install pipx for isolated tools (docker-mcp, etc.)
RUN pip install --no-cache-dir pipx

# Non-root user with docker group access — security hardening
RUN groupadd -r appuser && useradd -r -g appuser appuser \
    && (getent group docker || groupadd -o -g 999 docker) \
    && usermod -aG docker appuser

# Verify image
RUN python --version && pip list | head -5

# This is the base image — child Dockerfiles will FROM agent-base and add agent-specific deps
