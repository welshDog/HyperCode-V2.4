+#!/usr/bin/env python3
+"""
+Schema gate: structural validation of every touched skill / prompt /
+workflow file. Pure, offline, deterministic — no model calls.
+
+This file lives in evals/ and must never be modified by the
+self-improvement loop — only a human operator may change it.
+
+Usage: validate_frontmatter.py <target_dir>
+Exit 0 if every checked file is structurally valid, 1 otherwise.
+"""
+import pathlib
+import re
+import sys
+
+FRONTMATTER_RE = re.compile(r"\A---\n(.*?)\n---\n", re.S)
+
+
+def validate_skill(path: pathlib.Path):
+    text = path.read_text(encoding="utf-8", errors="ignore")
+    m = FRONTMATTER_RE.match(text)
+    if not m:
+        return False, f"FAIL {path}: missing '---\\nname: ...\\ndescription: ...\\n---' frontmatter"
+    fm = m.group(1)
+    if "name:" not in fm or "description:" not in fm:
+        return False, f"FAIL {path}: frontmatter missing required 'name' or 'description' field"
+    body = text[m.end():]
+    if not body.strip():
+        return False, f"FAIL {path}: body is empty after frontmatter"
+    return True, f"ok   {path}"
+
+
+def validate_workflow(path: pathlib.Path):
+    text = path.read_text(encoding="utf-8", errors="ignore")
+    if not text.strip():
+        return False, f"FAIL {path}: empty workflow file"
+    return True, f"ok   {path}"
+
+
+def validate_prompt(path: pathlib.Path):
+    text = path.read_text(encoding="utf-8", errors="ignore")
+    if not text.strip():
+        return False, f"FAIL {path}: empty prompt file"
+    return True, f"ok   {path}"
+
+
+def main(target_dir: str) -> int:
+    root = pathlib.Path(target_dir)
+    failures = []
+    checked = 0
+
+    for path in root.glob("skills/**/*.md"):
+        checked += 1
+        ok, msg = validate_skill(path)
+        print(msg)
+        if not ok:
+            failures.append(msg)
+
+    for pattern in ("workflows/**/*.yaml", "workflows/**/*.yml", "workflows/**/*.json"):
+        for path in root.glob(pattern):
+            checked += 1
+            ok, msg = validate_workflow(path)
+            print(msg)
+            if not ok:
+                failures.append(msg)
+
+    for path in root.glob("prompts/**/*"):
+        if path.is_file():
+            checked += 1
+            ok, msg = validate_prompt(path)
+            print(msg)
+            if not ok:
+                failures.append(msg)
+
+    print(f"schema_validation: checked={checked} failures={len(failures)}")
+    return 0 if not failures else 1
+
+
+if __name__ == "__main__":
+    sys.exit(main(sys.argv[1] if len(sys.argv) > 1 else "."))
