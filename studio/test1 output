+"""
+Human-approval gate. No change is ever promoted, and no rollback is ever
+executed, without an identity from auth/approvers.json vouching for it.
+
+This file, and auth/approvers.json, must never be modified by the
+self-improvement loop. Only a human operator may change them.
+"""
+import json
+import pathlib
+
+ROOT = pathlib.Path(__file__).resolve().parents[1]
+APPROVERS_PATH = ROOT / "auth" / "approvers.json"
+
+_AUTOMATED_IDENTITIES = {"agent", "self", "bot", "ci", "system"}
+
+
+class ApprovalError(Exception):
+    """Raised when an approver identity cannot be verified as human."""
+
+
+def load_approvers():
+    if not APPROVERS_PATH.exists():
+        return []
+    data = json.loads(APPROVERS_PATH.read_text(encoding="utf-8"))
+    return data.get("approvers", [])
+
+
+def verify_approver(approver_id: str) -> bool:
+    if not approver_id or approver_id.strip().lower() in _AUTOMATED_IDENTITIES:
+        raise ApprovalError("Automated identities may not approve, promote, or roll back changes.")
+    ids = {a["id"] for a in load_approvers() if isinstance(a, dict) and "id" in a}
+    if not ids:
+        raise ApprovalError(
+            "No approvers configured in auth/approvers.json — failing closed, "
+            "no promotions or rollbacks are permitted."
+        )
+    if approver_id not in ids:
+        raise ApprovalError(f"'{approver_id}' is not a recognized human approver.")
+    return True
