+"""
+The evaluator — the trusted gate every proposed change must pass before a
+human is even asked to look at it.
+
+This file lives in evals/, a directory the self-improvement loop must
+NEVER modify or propose changes to. Only a human operator may change it.
+
+Three independent gates run against the isolated worktree. A change that
+fails any one of them is rejected outright — there is no partial credit
+(fail-closed):
+
+  1. schema_validation     — structural correctness of touched files
+  2. regression_evaluation — previously-verified behavior must not break
+  3. holdout_evaluation    — behavior on cases never used to develop the
+                              change must still be acceptable
+"""
+import pathlib
+import subprocess
+import sys
+
+ROOT = pathlib.Path(__file__).resolve().parents[1]
+
+GATES = [
+    ("schema_validation", ROOT / "evals" / "schema" / "validate_frontmatter.py"),
+    ("regression_evaluation", ROOT / "evals" / "regression" / "run_regression.py"),
+    ("holdout_evaluation", ROOT / "evals" / "holdout" / "run_holdout.py"),
+]
+
+
+def _run(script: pathlib.Path, target_dir: str):
+    result = subprocess.run(
+        [sys.executable, str(script), str(target_dir)],
+        capture_output=True,
+        text=True,
+    )
+    return result.returncode == 0, (result.stdout + result.stderr)
+
+
+def run_all(target_dir):
+    """Run every gate. Returns (all_passed, {gate: 'pass'|'fail'}, {gate: log})."""
+    gates = {}
+    details = {}
+    for name, script in GATES:
+        ok, log = _run(script, target_dir)
+        gates[name] = "pass" if ok else "fail"
+        details[name] = log
+    passed = all(v == "pass" for v in gates.values())
+    return passed, gates, details
+
+
+if __name__ == "__main__":
