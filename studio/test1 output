@@ -0,0 +1,194 @@
+#!/usr/bin/env python3
+"""
+Controlled self-improvement loop — orchestrator CLI.
+
+This file lives in evolution/, a directory the self-improvement loop must
+NEVER modify. It is the harness; the agent operating the loop only edits
+files under skills/, prompts/, and workflows/, and drives this CLI as a
+tool call to get any such edit reviewed, isolated, evaluated, audited,
+approved, and (only then) promoted.
+
+Lifecycle implemented here:
+  1. Explain the problem            -> --problem text, recorded verbatim
+  2. Unified diff                   -> --diff <patch-file>
+  3. Apply only in an isolated      -> evolution/worktree.py
+     git worktree
+  4. Run regression + holdout evals -> evals/evaluator.py
+  5. Reject on any gate failure     -> policy/policy.py + evals/evaluator.py
+  6. Record the result              -> audit/logger.py (audit/changes.jsonl)
+  7. Require human approval         -> auth/approvals.py
+     before promotion
+  8. One-command rollback           -> deployment/rollback.sh
+
+Commands:
+  propose   Validate + isolate + evaluate a proposed diff
+  approve   Record explicit human approval for a proposed change
+  promote   Merge an approved change into the trunk (delegates to deployment/)
+  rollback  One-command revert to the previous promoted version
+  list      Show audit history
+  show      Show one change's full audit record
+"""
+import argparse
+import datetime
+import hashlib
+import json
+import pathlib
+import sys
+
+ROOT = pathlib.Path(__file__).resolve().parents[1]
+sys.path.insert(0, str(ROOT))
+
+from policy import policy as policy_mod  # noqa: E402
+from audit import logger as audit_log  # noqa: E402
+from auth import approvals  # noqa: E402
+from evals import evaluator  # noqa: E402
+from evolution import worktree, diffcheck  # noqa: E402
+from deployment import promote as promote_mod  # noqa: E402
+from deployment import rollback as rollback_mod  # noqa: E402
+
+
+def _new_change_id() -> str:
+    ts = datetime.datetime.utcnow().strftime("%Y%m%d-%H%M%S")
+    salt = hashlib.sha256(ts.encode() + str(id(ts)).encode()).hexdigest()[:6]
+    return f"chg-{ts}-{salt}"
+
+
+def cmd_propose(args) -> int:
+    diff_path = pathlib.Path(args.diff)
+    diff_text = diff_path.read_text(encoding="utf-8")
+    touched = diffcheck.touched_paths(diff_text)
+    change_id = _new_change_id()
+
+    base_record = {
+        "id": change_id,
+        "actor": "agent",
+        "target_paths": touched,
+        "problem": args.problem,
+        "diff_path": str(diff_path),
+    }
+
+    # Gate 0: policy — reject before anything is created on disk.
+    try:
+        policy_mod.enforce(touched)
+    except policy_mod.PolicyViolation as e:
+        audit_log.append({**base_record, "status": "rejected_policy", "reason": str(e)})
+        print(f"REJECTED (policy): {e}")
+        return 2
+
+    # Isolation: everything past this point happens only in a throwaway worktree.
+    wt_path = worktree.create(change_id)
+    try:
+        diffcheck.apply_in_worktree(diff_path.resolve(), wt_path)
+    except Exception as e:  # noqa: BLE001
+        audit_log.append({**base_record, "status": "rejected_apply_failed", "reason": str(e)})
+        worktree.destroy(change_id)
+        print(f"REJECTED (patch did not apply cleanly): {e}")
+        return 2
+
+    passed, gates, details = evaluator.run_all(wt_path)
+    if not passed:
+        audit_log.append({**base_record, "status": "rejected_eval", "gates": gates})
+        worktree.destroy(change_id)
+        print("REJECTED (evaluation gate failed):")
+        for k, v in gates.items():
+            print(f"  {k}: {v}")
+            if v == "fail":
+                print(details[k])
+        return 2
+
+    audit_log.append({
+        **base_record,
+        "status": "pending_human_approval",
+        "gates": gates,
+        "worktree": str(wt_path),
+        "branch": worktree.branch_name(change_id),
+    })
+    print(f"Change {change_id} passed all automated gates and is awaiting human approval.")
+    print(f"Review it at: {wt_path}")
+    print(f"Approve with: evolution/self_improve.py approve --change-id {change_id} --approver <your-id>")
+    return 0
+
+
+def cmd_approve(args) -> int:
+    record = audit_log.latest_for(args.change_id)
+    if not record or record.get("status") != "pending_human_approval":
+        print(f"Change {args.change_id} is not awaiting approval.")
+        return 2
+    approvals.verify_approver(args.approver)
+    audit_log.append({
+        "id": args.change_id,
+        "actor": f"human:{args.approver}",
+        "status": "approved",
+        "approved_by": f"human:{args.approver}",
+        "approved_at": datetime.datetime.utcnow().strftime("%Y-%m-%dT%H:%M:%SZ"),
+    })
+    print(f"Change {args.change_id} approved by {args.approver}. Ready to promote:")
+    print(f"  deployment/rollback.sh available afterward if needed.")
+    print(f"  evolution/self_improve.py promote --change-id {args.change_id} --approver {args.approver}")
+    return 0
+
+
+def cmd_promote(args) -> int:
+    commit = promote_mod.promote(args.change_id, args.approver)
+    worktree.destroy(args.change_id, keep_branch=False)
+    print(f"Promoted {args.change_id} as {commit}")
+    return 0
+
+
+def cmd_rollback(args) -> int:
+    commit = rollback_mod.rollback(args.approver, to_commit=args.to)
+    print(f"Rolled back to {commit}")
+    return 0
+
+
+def cmd_list(_args) -> int:
+    for r in audit_log.read_all():
+        print(f"{r.get('timestamp', '?'):20} {r.get('id', '?'):24} {r.get('status', '?'):24} {r.get('problem', '')[:60]}")
+    return 0
+
+
+def cmd_show(args) -> int:
+    for r in audit_log.read_all():
+        if r.get("id") == args.change_id:
+            print(json.dumps(r, indent=2, sort_keys=True))
+    return 0
+
+
+def main() -> None:
+    p = argparse.ArgumentParser(prog="self_improve.py", description=__doc__,
+                                 formatter_class=argparse.RawDescriptionHelpFormatter)
+    sub = p.add_subparsers(dest="command", required=True)
+
+    sp = sub.add_parser("propose", help="Validate, isolate, and evaluate a proposed diff")
+    sp.add_argument("--diff", required=True, help="Path to a unified diff file")
+    sp.add_argument("--problem", required=True, help="Plain-text description of the observed problem")
+    sp.set_defaults(func=cmd_propose)
+
+    sa = sub.add_parser("approve", help="Record explicit human approval")
+    sa.add_argument("--change-id", required=True)
+    sa.add_argument("--approver", required=True, help="Human id from auth/approvers.json")
+    sa.set_defaults(func=cmd_approve)
+
+    spr = sub.add_parser("promote", help="Merge an approved change into the trunk")
+    spr.add_argument("--change-id", required=True)
+    spr.add_argument("--approver", required=True, help="Must match the approving identity")
+    spr.set_defaults(func=cmd_promote)
+
+    sr = sub.add_parser("rollback", help="One-command revert to the previous promoted version")
+    sr.add_argument("--approver", required=True, help="Human id from auth/approvers.json")
+    sr.add_argument("--to", default=None, help="Optional specific commit to roll back to")
+    sr.set_defaults(func=cmd_rollback)
+
+    sl = sub.add_parser("list", help="Show audit history")
+    sl.set_defaults(func=cmd_list)
+
+    ss = sub.add_parser("show", help="Show one change's full audit record(s)")
+    ss.add_argument("--change-id", required=True)
+    ss.set_defaults(func=cmd_show)
+
+    args = p.parse_args()
+    sys.exit(args.func(args))
+
+
+if __name__ == "__main__":
+    main()
