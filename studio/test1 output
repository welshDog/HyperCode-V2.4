+"""
+Promotion rules — the ONLY code path that ever merges a self-improvement
+change into the trunk branch.
+
+Requires, in order:
+  1. an audit record for the change in 'approved' state
+  2. a human approver recognized by auth/approvers.json
+  3. that the promoting identity is the SAME human who approved the change
+
+This file, and deployment/rollback.py and deployment/state.json, must
+never be modified by the self-improvement loop — only a human operator
+may change them.
+"""
+import json
+import pathlib
+import subprocess
+import sys
+
+ROOT = pathlib.Path(__file__).resolve().parents[1]
+sys.path.insert(0, str(ROOT))
+
+from audit import logger  # noqa: E402
+from auth import approvals  # noqa: E402
+
+STATE_PATH = ROOT / "deployment" / "state.json"
+
+
+def _load_state():
+    if not STATE_PATH.exists():
+        return {"current_commit": None, "history": []}
+    return json.loads(STATE_PATH.read_text(encoding="utf-8"))
+
+
+def _save_state(state):
+    STATE_PATH.write_text(json.dumps(state, indent=2) + "\n", encoding="utf-8")
+
+
+def promote(change_id: str, approver_id: str, target_branch: str = "main") -> str:
+    record = logger.latest_for(change_id)
+    if not record:
+        raise SystemExit(f"No audit record found for {change_id}")
+    if record.get("status") != "approved":
+        raise SystemExit(
+            f"Change {change_id} is not in 'approved' state (status={record.get('status')}). "
+            "Run 'approve' first."
+        )
+    approvals.verify_approver(approver_id)
+    if record.get("approved_by") != f"human:{approver_id}":
+        raise SystemExit("Promotion must be run by the same human identity that approved the change.")
+
+    branch = f"self-improve/{change_id}"
+    prev_commit = subprocess.run(
+        ["git", "rev-parse", target_branch], cwd=str(ROOT), capture_output=True, text=True, check=True,
+    ).stdout.strip()
+
+    subprocess.run(["git", "checkout", target_branch], cwd=str(ROOT), check=True)
+    subprocess.run(
+        ["git", "merge", "--no-ff", branch, "-m", f"self-improve: promote {change_id}"],
+        cwd=str(ROOT), check=True,
+    )
+    new_commit = subprocess.run(
+        ["git", "rev-parse", target_branch], cwd=str(ROOT), capture_output=True, text=True, check=True,
+    ).stdout.strip()
+
+    state = _load_state()
+    if state.get("current_commit"):
+        state["history"].append(state["current_commit"])
+    state["current_commit"] = new_commit
+    _save_state(state)
+
+    logger.append({
+        "id": change_id,
+        "actor": f"human:{approver_id}",
+        "status": "promoted",
+        "promoted_commit": new_commit,
+        "previous_commit": prev_commit,
+    })
+    return new_commit
+
+
+if __name__ == "__main__":
+    if len(sys.argv) != 3:
+        raise SystemExit("usage: promote.py <change-id> <approver-id>")
+    print(promote(sys.argv[1], sys.argv[2]))
