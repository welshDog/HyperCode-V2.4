+change. In this scaffold both agent and human can technically read this
+file (read access isn't restricted, only writes are policy-blocked) — for
+a stronger guarantee in a real deployment, keep the true holdout set in a
+separate service or repository the proposing agent has no read access to
+at all, and have only the evaluator fetch it at evaluation time.
+
+This file lives in evals/ and must never be modified by the
+self-improvement loop — only a human operator may change it.
+
+Usage: run_holdout.py <target_dir>
+"""
+import json
+import os
+import pathlib
+import subprocess
+import sys
+
+HERE = pathlib.Path(__file__).resolve().parent
+CASES_PATH = HERE / "cases.json"
+
+
+def load_cases():
+    if not CASES_PATH.exists():
+        return []
+    return json.loads(CASES_PATH.read_text(encoding="utf-8"))
+
+
+def find_skill_file(target_dir, name):
+    target = pathlib.Path(target_dir)
+    candidates = (
+        list(target.glob(f"skills/**/{name}/SKILL.md"))
+        + list(target.glob(f"skills/**/*{name}*.md"))
+        + list(target.glob(f"prompts/**/*{name}*"))
+        + list(target.glob(f"workflows/**/*{name}*"))
+    )
+    return candidates[0] if candidates else None
+
+
+def grade_case(case, target_dir):
+    grader_cmd = os.environ.get("SELF_IMPROVE_GRADER_CMD")
+    if grader_cmd:
+        proc = subprocess.run(
+            grader_cmd, shell=True, input=json.dumps(case),
+            text=True, capture_output=True, cwd=target_dir,
+        )
