--- /dev/null
+++ b/evolution/diffcheck.py
@@ -0,0 +1,43 @@
+"""
+Unified-diff inspection. Every proposed diff is parsed here BEFORE
+anything is created or applied, so the safety policy check
+(policy/policy.py) always sees the true set of touched paths, regardless
+of what the diff's accompanying prose claims.
+
+This file lives in evolution/, a directory the self-improvement loop must
+never modify — only a human operator may change it.
+"""
+import pathlib
+import re
+import subprocess
+
+DIFF_GIT_RE = re.compile(r"^diff --git a/(\S+) b/(\S+)", re.M)
+PLUSPLUS_RE = re.compile(r"^\+\+\+ b/(\S+)", re.M)
+MINUSMINUS_RE = re.compile(r"^--- a/(\S+)", re.M)
+
+
+def touched_paths(diff_text: str):
+    """Every path this diff creates, modifies, or deletes."""
+    paths = set()
+    for a, b in DIFF_GIT_RE.findall(diff_text):
+        paths.add(a)
+        paths.add(b)
+    for b in PLUSPLUS_RE.findall(diff_text):
+        paths.add(b)
+    for a in MINUSMINUS_RE.findall(diff_text):
+        paths.add(a)
+    paths.discard("dev/null")
+    return sorted(paths)
+
+
+def apply_in_worktree(diff_path: pathlib.Path, worktree_dir: pathlib.Path) -> None:
+    """Apply a unified diff inside an isolated worktree only. Raises
+    subprocess.CalledProcessError if the patch does not apply cleanly."""
+    subprocess.run(
+        ["git", "apply", "--whitespace=nowarn", "--check", str(diff_path)],
+        cwd=str(worktree_dir), check=True,
+    )
+    subprocess.run(
+        ["git", "apply", "--whitespace=nowarn", str(diff_path)],
+        cwd=str(worktree_dir), check=True,
+    )
