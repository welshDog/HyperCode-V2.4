+"""
+One-command rollback to the previous promoted version.
+
+This file, and deployment/promote.py and deployment/state.json, must
+never be modified by the self-improvement loop — only a human operator
+may change them.
+"""
+import json
+import pathlib
+import subprocess
+import sys
+
+ROOT = pathlib.Path(__file__).resolve().parents[1]
+sys.path.insert(0, str(ROOT))
+
+from audit import logger  # noqa: E402
+from auth import approvals  # noqa: E402
+
+STATE_PATH = ROOT / "deployment" / "state.json"
+
+
+def _load_state():
+    if not STATE_PATH.exists():
+        return {"current_commit": None, "history": []}
+    return json.loads(STATE_PATH.read_text(encoding="utf-8"))
+
+
+def _save_state(state):
+    STATE_PATH.write_text(json.dumps(state, indent=2) + "\n", encoding="utf-8")
+
+
+def rollback(approver_id: str, target_branch: str = "main", to_commit: str = None) -> str:
+    approvals.verify_approver(approver_id)
+    state = _load_state()
+
+    if to_commit is None:
+        if not state["history"]:
+            raise SystemExit("No previous promoted version recorded — nothing to roll back to.")
+        to_commit = state["history"].pop()
+    elif to_commit in state["history"]:
+        idx = state["history"].index(to_commit)
+        state["history"] = state["history"][:idx]
+
+    current = state.get("current_commit")
+    subprocess.run(["git", "checkout", target_branch], cwd=str(ROOT), check=True)
+    subprocess.run(["git", "reset", "--hard", to_commit], cwd=str(ROOT), check=True)
+
+    state["current_commit"] = to_commit
+    _save_state(state)
+
+    logger.append({
+        "id": f"rollback-{to_commit[:12]}",
+        "actor": f"human:{approver_id}",
+        "status": "rolled_back",
+        "rolled_back_to": to_commit,
+        "previous_commit": current,
+    })
+    return to_commit
+
+
+if __name__ == "__main__":
+    if len(sys.argv) < 2:
+        raise SystemExit("usage: rollback.py <approver-id> [commit-to-roll-back-to]")
+    approver = sys.argv[1]
+    target = sys.argv[2] if len(sys.argv) > 2 else None
+    print(rollback(approver, to_commit=target))
