+"""
+The safety policy engine — the single source of truth for what the
+self-improvement loop is allowed to touch.
+
+This file, and policy/self_improvement_policy.json, must NEVER be modified
+by the self-improvement loop itself, and no proposed diff may touch them —
+that is enforced structurally: this module is what rejects any diff that
+tries. Only a human operator, working outside the loop, may change this
+policy.
+"""
+import json
+import pathlib
+
+ROOT = pathlib.Path(__file__).resolve().parents[1]
+POLICY_PATH = ROOT / "policy" / "self_improvement_policy.json"
+
+
+class PolicyViolation(Exception):
+    """Raised when a proposed change touches a path the policy forbids."""
+
+
+def load_policy():
+    with POLICY_PATH.open(encoding="utf-8") as f:
+        return json.load(f)
+
+
+def _norm(path: str) -> str:
+    return path.replace("\\", "/").lstrip("./")
+
+
+def is_allowed(path: str, policy: dict) -> bool:
+    """Deny-by-default: a path is allowed only if it falls under an entry in
+    allowed_paths AND does not fall under any entry in forbidden_paths.
+    forbidden_paths always wins, even if it were somehow also listed as
+    allowed (defense in depth against a malformed policy edit)."""
+    p = _norm(path)
+    for forbidden in policy["forbidden_paths"]:
+        stem = forbidden.rstrip("/")
+        if p == stem or p.startswith(stem + "/"):
+            return False
+    for allowed in policy["allowed_paths"]:
+        if p.startswith(allowed):
+            return True
+    return False
+
+
+def enforce(paths, policy=None):
+    """Raise PolicyViolation unless every path in `paths` is allowed.
+
+    Called BEFORE a worktree is created and BEFORE any diff is applied, so
+    a malicious or buggy proposal never even touches disk outside of the
+    diff file it arrived as.
+    """
+    policy = policy or load_policy()
+    if not paths:
+        raise PolicyViolation("Proposed diff touches no files — nothing to evaluate.")
+    violations = [p for p in paths if not is_allowed(p, policy)]
+    if violations:
+        raise PolicyViolation(
+            "Proposed change touches path(s) outside the allowed set "
+            f"{policy['allowed_paths']} (or inside a forbidden path "
+            f"{policy['forbidden_paths']}): {violations}"
+        )
