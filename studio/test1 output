+name: self-improvement-guard
+
+# Defense-in-depth for the agent self-improvement loop (see evolution/README.md).
+# The evolution/self_improve.py CLI already enforces the policy boundary and
+# runs the eval gates before a change is even proposed for human review, but
+# this workflow re-checks independently at the PR boundary — it does not
+# trust the CLI's own output, so a compromised or buggy CLI invocation still
+# can't get a forbidden-path change merged.
+#
+# This file lives under .github/workflows/, which is covered by the same
+# "evolution/deployment/policy" trust boundary as the rest of the harness:
+# the self-improvement loop must never modify it.
+
+on:
+  pull_request:
+    branches: [main]
+
+jobs:
+  enforce-boundaries:
+    if: startsWith(github.head_ref, 'self-improve/')
+    runs-on: ubuntu-latest
+    steps:
+      - uses: actions/checkout@v4
+        with:
+          fetch-depth: 0
+
+      - name: Diff must stay inside skills/ prompts/ workflows/
+        env:
+          BASE_SHA: ${{ github.event.pull_request.base.sha }}
+          HEAD_SHA: ${{ github.event.pull_request.head.sha }}
+        run: |
+          set -euo pipefail
+          CHANGED=$(git diff --name-only "$BASE_SHA" "$HEAD_SHA")
+          echo "Changed files:"
+          echo "$CHANGED"
+
+          FORBIDDEN='^(policy|security|auth|evals|evolution|deployment|audit)/'
+          BAD=$(echo "$CHANGED" | grep -E "$FORBIDDEN" || true)
+          if [ -n "$BAD" ]; then
+            echo "::error::Self-improvement branch touched forbidden path(s):"
+            echo "$BAD"
+            exit 1
+          fi
+
+          ALLOWED='^(skills|prompts|workflows)/'
+          OUTSIDE=$(echo "$CHANGED" | grep -vE "$ALLOWED" || true)
+          if [ -n "$OUTSIDE" ]; then
+            echo "::error::Self-improvement branch touched path(s) outside skills/, prompts/, workflows/:"
+            echo "$OUTSIDE"
+            exit 1
+          fi
+
+      - name: audit/changes.jsonl must not be touched by a proposal branch
+        env:
+          BASE_SHA: ${{ github.event.pull_request.base.sha }}
+          HEAD_SHA: ${{ github.event.pull_request.head.sha }}
+        run: |
+          set -euo pipefail
+          if git diff --name-only "$BASE_SHA" "$HEAD_SHA" -- audit/changes.jsonl | grep -q .; then
+            echo "::error::audit/changes.jsonl changed on a self-improvement branch, but that file is forbidden to this branch type."
+            exit 1
+          fi
+
+      - name: Run schema + regression + holdout evals against the PR head
+        run: |
+          set -euo pipefail
+          python3 evals/schema/validate_frontmatter.py .
+          python3 evals/regression/run_regression.py .
+          python3 evals/holdout/run_holdout.py .
