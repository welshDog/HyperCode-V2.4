+"""
+The audit logger — an append-only, immutable ledger of every proposal,
+rejection, approval, promotion, and rollback the self-improvement loop
+ever produces.
+
+This file, and audit/changes.jsonl, must never be modified by the
+self-improvement loop. Note there is intentionally no update() or
+delete() function here: append() is the only supported write operation,
+by design, so the trail cannot be quietly edited after the fact.
+"""
+import datetime
+import json
+import pathlib
+
+ROOT = pathlib.Path(__file__).resolve().parents[1]
+LOG_PATH = ROOT / "audit" / "changes.jsonl"
+
+
+def _now() -> str:
+    return datetime.datetime.utcnow().strftime("%Y-%m-%dT%H:%M:%SZ")
+
+
+def append(record: dict) -> dict:
+    """Append one JSON object as a new line. Never truncates, never rewrites
+    existing lines."""
+    record = dict(record)
+    record.setdefault("timestamp", _now())
+    LOG_PATH.parent.mkdir(parents=True, exist_ok=True)
+    with LOG_PATH.open("a", encoding="utf-8") as f:
+        f.write(json.dumps(record, sort_keys=True) + "\n")
+    return record
+
+
+def read_all():
+    if not LOG_PATH.exists():
+        return []
+    with LOG_PATH.open(encoding="utf-8") as f:
+        return [json.loads(line) for line in f if line.strip()]
+
+
+def latest_for(change_id: str):
+    """Return the most recent record for a change id (records accumulate
+    one per lifecycle event: proposed -> rejected/pending -> approved ->
+    promoted, so the latest reflects current status)."""
+    records = [r for r in read_all() if r.get("id") == change_id]
+    return records[-1] if records else None
