+"""
+Isolated git worktree management for proposed self-improvement changes.
+
+Every proposal is applied and evaluated in its own throwaway git worktree
+and branch under .evolution-worktrees/ — it never touches the primary
+working tree until a human has approved it and `promote` has explicitly
+merged it in.
+
+This file lives in evolution/, a directory the self-improvement loop must
+never modify — only a human operator may change it.
+"""
+import pathlib
+import subprocess
+
+ROOT = pathlib.Path(__file__).resolve().parents[1]
+WORKTREE_ROOT = ROOT / ".evolution-worktrees"
+
+
+def branch_name(change_id: str) -> str:
+    return f"self-improve/{change_id}"
+
+
+def worktree_path(change_id: str) -> pathlib.Path:
+    return WORKTREE_ROOT / change_id
+
+
+def create(change_id: str, base_ref: str = "HEAD") -> pathlib.Path:
+    path = worktree_path(change_id)
+    WORKTREE_ROOT.mkdir(parents=True, exist_ok=True)
+    subprocess.run(
+        ["git", "worktree", "add", "-b", branch_name(change_id), str(path), base_ref],
+        cwd=str(ROOT), check=True,
+    )
+    return path
+
+
+def destroy(change_id: str, keep_branch: bool = False) -> None:
+    path = worktree_path(change_id)
+    subprocess.run(["git", "worktree", "remove", "--force", str(path)], cwd=str(ROOT), check=False)
+    if not keep_branch:
+        subprocess.run(["git", "branch", "-D", branch_name(change_id)], cwd=str(ROOT), check=False)
