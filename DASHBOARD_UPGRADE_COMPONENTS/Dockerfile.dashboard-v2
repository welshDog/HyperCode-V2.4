# Multi-stage Dockerfile for Dashboard v2.0 Upgrade

FROM node:20.20.2-alpine AS builder

WORKDIR /build

# Copy existing dashboard source (if available)
COPY . .

# Copy new dashboard components
COPY DASHBOARD_UPGRADE_COMPONENTS/AgentMonitor.tsx ./app/components/dashboard/
COPY DASHBOARD_UPGRADE_COMPONENTS/HyperCodeIDE.tsx ./app/components/dashboard/
COPY DASHBOARD_UPGRADE_COMPONENTS/MissionTimeline.tsx ./app/components/dashboard/
COPY DASHBOARD_UPGRADE_COMPONENTS/DockerZone.tsx ./app/components/dashboard/
COPY DASHBOARD_UPGRADE_COMPONENTS/MCPToolBrowser.tsx ./app/components/dashboard/
COPY DASHBOARD_UPGRADE_COMPONENTS/hooks/useAgentStream.ts ./app/hooks/
COPY DASHBOARD_UPGRADE_COMPONENTS/lib/api-client.ts ./app/lib/
COPY DASHBOARD_UPGRADE_COMPONENTS/app_dashboard_page.tsx ./app/app/dashboard/page.tsx

# Install dependencies
RUN npm ci --only=production && \
    npm run build

# Runtime stage
FROM node:20.20.2-alpine

RUN addgroup -g 101 -S nextjs && \
    adduser -S -D -H -u 101 -h /app -s /sbin/nologin -G nextjs -g nextjs nextjs

WORKDIR /app

COPY --from=builder /build/node_modules ./node_modules
COPY --from=builder /build/.next ./.next
COPY --from=builder /build/public ./public
COPY --from=builder /build/package.json ./package.json
COPY --from=builder /build/server.js ./server.js

EXPOSE 3000

ENV NODE_ENV=production \
    NEXT_TELEMETRY_DISABLED=1

USER nextjs

CMD ["node", "server.js"]
