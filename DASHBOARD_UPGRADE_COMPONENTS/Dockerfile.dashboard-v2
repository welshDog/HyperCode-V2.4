# Multi-stage Dockerfile for Dashboard v2.0 Upgrade
# Build context = DASHBOARD_UPGRADE_COMPONENTS/ folder
# Run: docker build -f DASHBOARD_UPGRADE_COMPONENTS/Dockerfile.dashboard-v2 DASHBOARD_UPGRADE_COMPONENTS/ -t hypercode-dashboard-v2

FROM node:20.20.2-alpine AS builder

WORKDIR /build

# Install deps first (cached layer - only reruns if package.json changes)
COPY package*.json ./
RUN npm ci

# Copy only what Next.js needs to build
COPY next.config.* ./
COPY tsconfig*.json ./
COPY public/ ./public/
COPY app/ ./app/
COPY src/ ./src/

# Copy new dashboard components into correct locations
# Note: paths are relative to DASHBOARD_UPGRADE_COMPONENTS/ context
COPY AgentMonitor.tsx ./app/components/dashboard/
COPY HyperCodeIDE.tsx ./app/components/dashboard/
COPY MissionTimeline.tsx ./app/components/dashboard/
COPY DockerZone.tsx ./app/components/dashboard/
COPY MCPToolBrowser.tsx ./app/components/dashboard/
COPY hooks/useAgentStream.ts ./app/hooks/
COPY lib/api-client.ts ./app/lib/
COPY app_dashboard_page.tsx ./app/app/dashboard/page.tsx

# Build production bundle
RUN npm run build

# --- Runtime stage (lean image) ---
FROM node:20.20.2-alpine

RUN addgroup -g 101 -S nextjs && \
    adduser -S -D -H -u 101 -h /app -s /sbin/nologin -G nextjs -g nextjs nextjs

WORKDIR /app

COPY --from=builder /build/node_modules ./node_modules
COPY --from=builder /build/.next ./.next
COPY --from=builder /build/public ./public
COPY --from=builder /build/package.json ./package.json
COPY --from=builder /build/server.js ./server.js

EXPOSE 3000

ENV NODE_ENV=production \
    NEXT_TELEMETRY_DISABLED=1

USER nextjs

CMD ["node", "server.js"]
