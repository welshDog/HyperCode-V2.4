# Production-optimized Dockerfile for HyperCode
# Multi-stage builds to minimize final image size and attack surface
# syntax=docker/dockerfile:1.4

# ==================== BUILDER STAGE ====================
# Dedicated stage for dependency installation with pip cache optimization
ARG PYTHON_VERSION=3.11
ARG PYTHON_IMAGE=python:3.11-slim-bookworm

FROM ${PYTHON_IMAGE} as builder

# Cache pip downloads across builds (requires BuildKit: DOCKER_BUILDKIT=1)
RUN --mount=type=cache,target=/root/.cache/pip \
    pip install --upgrade pip setuptools wheel

# Create a cached layer for requirements installation
COPY requirements*.txt ./
RUN --mount=type=cache,target=/root/.cache/pip \
    pip install --no-cache-dir -r requirements.txt

# ==================== RUNTIME STAGE (Python Services) ====================
# Minimal runtime image for production services (agents, core, orchestrator)
FROM ${PYTHON_IMAGE} as runtime

# Security: Install minimal runtime dependencies only
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    postgresql-client \
    && rm -rf /var/lib/apt/lists/* /tmp/* /var/tmp/*

# Security: Create non-root user for running services
RUN groupadd -r hypercode && useradd -r -g hypercode hypercode

# Copy pre-built Python packages from builder stage (avoid re-compiling wheels)
COPY --from=builder /usr/local/lib/python${PYTHON_VERSION}/site-packages \
     /usr/local/lib/python${PYTHON_VERSION}/site-packages

COPY --from=builder /usr/local/bin /usr/local/bin

WORKDIR /app

# Copy only application code (excluded build artifacts via .dockerignore)
COPY --chown=hypercode:hypercode . .

# Drop privileges: run all processes as non-root user
USER hypercode

# Healthcheck template (override with service-specific checks in docker-compose)
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD python -c "import httpx; httpx.get('http://localhost:8000/health', timeout=3)" || exit 1

# Default entrypoint; override in docker-compose for service-specific apps
CMD ["python", "-m", "uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000"]

# ==================== DEVELOPMENT STAGE ====================
# Full-featured development with testing and debugging
FROM ${PYTHON_IMAGE} as development

# Install dev system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    postgresql-client \
    git \
    && rm -rf /var/lib/apt/lists/* /tmp/* /var/tmp/*

# Install development Python packages with cache
RUN --mount=type=cache,target=/root/.cache/pip \
    pip install --upgrade pip setuptools wheel && \
    pip install \
    pytest \
    pytest-cov \
    pytest-asyncio \
    pytest-mock \
    pytest-xdist \
    pytest-timeout \
    black \
    ruff \
    mypy \
    ipython \
    debugpy \
    pre-commit \
    coverage[toml] \
    pytest-html \
    bandit \
    safety \
    faker \
    factory-boy \
    hypothesis \
    responses \
    freezegun

WORKDIR /workspace
COPY . .

CMD ["/bin/bash"]

# ==================== TESTING STAGE ====================
# Dedicated testing environment with test-specific dependencies
FROM development as testing

RUN --mount=type=cache,target=/root/.cache/pip \
    pip install pytest-json-report pytest-benchmark

WORKDIR /tests

CMD ["pytest", "-v", "--cov", "--cov-report=html"]

# ==================== CI STAGE ====================
# CI/CD pipeline execution with security scanning
FROM development as ci

# Already includes coverage, bandit, safety from development stage

WORKDIR /ci

CMD ["/bin/bash"]

# ==================== DOCUMENTATION STAGE ====================
# Lightweight documentation builder
FROM ${PYTHON_IMAGE} as docs

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/* /tmp/* /var/tmp/*

RUN --mount=type=cache,target=/root/.cache/pip \
    pip install --upgrade pip && \
    pip install \
    mkdocs \
    mkdocs-material \
    mkdocstrings[python] \
    mkdocs-gen-files \
    mkdocs-literate-nav \
    mkdocs-section-index

WORKDIR /docs
COPY . .

CMD ["mkdocs", "serve", "--dev-addr=0.0.0.0:8000"]

# ==================== DATABASE MIGRATION STAGE ====================
# Minimal database migration runner
FROM ${PYTHON_IMAGE} as migration

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    postgresql-client \
    && rm -rf /var/lib/apt/lists/* /tmp/* /var/tmp/*

RUN --mount=type=cache,target=/root/.cache/pip \
    pip install --upgrade pip && \
    pip install alembic sqlalchemy

WORKDIR /migrations
COPY . .

CMD ["alembic", "upgrade", "head"]
