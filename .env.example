# ============================================================
# HyperCode V2.4 — .env.example
# ============================================================
# Copy to .env and fill in NON-SECRET values only.
# Secrets (passwords, tokens, keys) → use Docker secrets instead.
# Run: bash scripts/secrets-init.sh
#
# ⚠️  NEVER commit .env to git. It is in .gitignore.
# 📌  Keys marked [REQUIRED] must be set for the stack to boot.
# 📌  Keys marked [OPTIONAL] can stay empty unless you use that feature.
# ============================================================

# ── Paths ────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────
HC_DATA_ROOT=/mnt/d/hypercode-data   # [REQUIRED] change to your data drive path

# ── Environment ─────────────────────────────────────────────────────────────────────────────────────────────────────────────
ENVIRONMENT=development

# ── Database [REQUIRED] ─────────────────────────────────────────────────────────────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_DB=hypercode          # [ADDED — was missing from root .env]
# POSTGRES_PASSWORD → secrets/postgres_password.txt ✅
# POSTGRES_HOST: leave unset for normal local use — every compose file that builds a
# postgres:// URL now interpolates ${POSTGRES_HOST:-postgres}, defaulting to the
# in-Docker-network hostname (today's only real setup). Only set this if Postgres has
# actually been moved to a different host (e.g. a Tailscale IP after a cloud-split
# migration) — then it's a single .env line instead of a repo-wide sweep. Does NOT
# cover services that read a pre-built ${DATABASE_URL} from .env directly (see docs/
# NEXT_SESSION_HANDOVER_2026-08-23-afternoon.md for the exact list) — those still need
# their own DATABASE_URL edit on a real host move.
# POSTGRES_HOST=postgres

# ── Redis [REQUIRED] ───────────────────────────────────────────────────────────────────────────────────────────────────────
HYPERCODE_REDIS_URL=redis://redis:6379/0
# REDIS_HOST: same deal as POSTGRES_HOST above — leave unset for normal local use.
# REDIS_HOST=redis

# ── BROskiPets ────────────────────────────────────────────────────────────────────────────────────────────────────────────
BROSKIE_PETS_ENABLED=true     # [DEDUPED — was defined twice, one removed]
PETS_REDIS_DB=3
PETS_BRIDGE_URL=http://broski-pets-bridge:8098   # internal Docker name, not 127.0.0.1
PETS_DISCORD_ID=
PETS_WEBHOOK_SECRET=           # [DEDUPED — was defined twice, one removed]
PETS_OLLAMA_MODEL=qwen2.5:7b
MCP_GATEWAY_URL=http://mcp-gateway:8099   # internal Docker name, not 127.0.0.1
GITHUB_TOKEN=

# ── CORS ──────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────
CORS_ALLOW_ORIGINS=http://localhost:8088,http://127.0.0.1:8088,http://localhost:3000

# ── Observability ───────────────────────────────────────────────────────────────────────────────────────────────────────────────────
PROMETHEUS_RETENTION=30d
PROMETHEUS_RETENTION_SIZE=10GB
OTLP_EXPORTER_DISABLED=false
GF_SECURITY_ADMIN_USER=admin
# GF_SECURITY_ADMIN_PASSWORD → secrets/grafana_admin_password.txt ✅

# ── Ollama ──────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────
OLLAMA_MODEL=qwen2.5-coder:3b

# ── Orchestration ───────────────────────────────────────────────────────────────────────────────────────────────────────────────────
ORCHESTRATOR_ENABLED_AGENTS=
SMOKE_ENDPOINT_ENABLED=false
SMOKE_KEY_ALLOWLIST=
SMOKE_KEY_TTL_SECONDS=900

# ── Mission / Course Sync ─────────────────────────────────────────────────────────────────────────────────────────────────
MISSION_CONTROL_URL=
COURSE_SYNC_SECRET=
SHOP_SYNC_SECRET=

# ── Alerts [OPTIONAL — only needed if using alert integrations] ─────────────────────────────────────────────────────────────────────
SLACK_WEBHOOK_URL=             # [ADDED — was missing from root .env]
PD_ROUTING_KEY=                # [ADDED — was missing from root .env]
DISCORD_OOM_WEBHOOK_URL=       # [ADDED — was missing from root .env] Discord alert webhook
RESTART_LOOP_THRESHOLD=5       # [ADDED — was missing from root .env]

# ── Discord ──────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────
DISCORD_GUILD_ID=YOUR_GUILD_ID_HERE   # set to your server ID
DISCORD_USER_ID=                       # [ADDED] for `make calm` token awards
# DISCORD_TOKEN → secrets/discord_token.txt ✅

# ── External APIs (all via Docker secrets) ───────────────────────────────────────────────────────────────────────────────────
# OPENAI_API_KEY       → secrets/openai_api_key.txt ✅

# API_KEY              → secrets/api_key.txt ✅
# HYPERCODE_JWT_SECRET → secrets/jwt_secret.txt ✅
# ORCHESTRATOR_API_KEY → secrets/orchestrator_api_key.txt ✅
# MINIO_ROOT_USER      → secrets/minio_root_user.txt ✅
# MINIO_ROOT_PASSWORD  → secrets/minio_root_password.txt ✅
# HYPERCODE_MEMORY_KEY → secrets/memory_key.txt ✅

# ── Hyper Brain [OPTIONAL — only needed if running docker-compose.brain.yml] ───────────────────────────────────────────────────────────────────────────────────
GITHUB_WEBHOOK_SECRET=         # required by hyper-brain in docker-compose.brain.yml

# ── Grafana Cloud [OPTIONAL — only needed if running docker-compose.grafana-cloud.yml] ──────────────────────────────────────────────────────────────────────────────
GRAFANA_CLOUD_ACCESS_TOKEN=
GRAFANA_CLOUD_LOKI_URL=
GRAFANA_CLOUD_LOKI_USERNAME=
GRAFANA_CLOUD_PROMETHEUS_URL=
GRAFANA_CLOUD_PROMETHEUS_USERNAME=
GRAFANA_CLOUD_TEMPO_URL=
GRAFANA_CLOUD_TEMPO_USERNAME=
