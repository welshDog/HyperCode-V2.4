# HyperCode Environment Configuration

# Application
APP_NAME=HyperCode
APP_VERSION=2.4.0
DEBUG=False

# Database
DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/hypercode
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# Redis
REDIS_URL=redis://localhost:6379/0
REDIS_CACHE_DB=1
REDIS_RATE_LIMIT_DB=2

# Authentication
SECRET_KEY=your-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# LLM Providers
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# OpenRouter (free models)
OPENROUTER_API_KEY=sk-or-v1-your-key-here
OPENROUTER_DEFAULT_MODEL=mistralai/mistral-7b-instruct:free

# Observability
PROMETHEUS_URL=http://localhost:9090
GRAFANA_URL=http://localhost:3000
SENTRY_DSN=

# Storage
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=hypercode

# CORS
CORS_ORIGINS=["http://localhost:3000","http://localhost:8088","http://127.0.0.1:8088"]

# MemStream (throttle-agent dependency — generate real tokens via: openssl rand -hex 16)
MEMSTREAM_HEALTH_TOKEN=changeme
MEMSTREAM_API_TOKEN=generate-via-openssl-rand-hex-16

# Muse Code (Meta AI coding agent)
# Get API key from: https://developer.meta.com
MUSE_API_KEY=your_meta_api_key_here

# Contributor tier: true = cheaper (~21x, data used for training)
#                   false = Standard tier (private prompts)
MUSE_CONTRIBUTOR_TIER=true

# Project root to mount into the container (default: current dir)
PROJECT_ROOT=.

# Data root for Muse config & event log (matches other HyperCode services)
HC_DATA_ROOT=/data/hypercode